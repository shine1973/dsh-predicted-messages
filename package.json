{
  "name": "dsh-predicted-messages",
  "version": "0.1.7",
  "type": "module",
  "description": "Predict your next message in DeepSeek Harness and adopt it as an editable draft. 根据对话预测下一条消息，点击填入草稿。",
  "license": "MIT",
  "author": "shine1973",
  "homepage": "https://github.com/shine1973/dsh-predicted-messages#readme",
  "repository": { "type": "git", "url": "git+https://github.com/shine1973/dsh-predicted-messages.git" },
  "bugs": { "url": "https://github.com/shine1973/dsh-predicted-messages/issues" },
  "keywords": ["deepseek-harness", "dsh", "cordis", "plugin", "predicted-messages", "suggestions"],
  "engines": { "node": ">=22", "dsh": ">=0.2.2-rc.1 <0.3.0" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "core.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README.en.md", "CHANGELOG.md", "LICENSE"],
  "scripts": {
    "check": "node --check index.js && node --check core.js && node --check client.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "zod": "4.6.7"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.1.0" },
  "peerDependenciesMeta": { "@deepseek-ai/cordis": { "optional": true } },
  "devDependencies": { "@deepseek-ai/cordis": "4.1.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-session"] }
  }
}
